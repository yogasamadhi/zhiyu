# Use long, independently generated values. Do not commit the populated .env file.
ZHIYUN_IMAGE=zhiyun/zhiyun:1.0.0
POSTGRES_PASSWORD=replace-with-a-random-database-password
ZHIYUN_DOMAIN=zhiyun.example.com
ZHIYUN_PUBLIC_URL=https://zhiyun.example.com
ZHIYUN_CREDENTIAL_KEY=replace-with-a-random-32-byte-encryption-key
ZHIYUN_BOOTSTRAP_TOKEN=replace-with-a-random-token-of-at-least-32-bytes
