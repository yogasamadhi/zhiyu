    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.8",
    "zod": "^4.1.13",
    "nodemailer": "^10.0.6",
    "otpauth": "^9.5.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.9",
    "@types/nodemailer": "^7.0.11"
  }
}
