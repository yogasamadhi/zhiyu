{
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "name": "@zhiyun/cloud-server",
  "scripts": {
    "dev": "bun --watch src/start.ts",
    "worker": "bun src/worker.ts",
    "migrate": "bun src/migrate.ts",
