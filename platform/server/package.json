{
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "name": "@zhiyun/cloud-server",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/migrate.ts",
    "admin:create": "tsx src/bootstrap-admin.ts",
    "build": "node ../../tooling/scripts/build-package.ts src/start.ts src/worker.ts src/migrate.ts src/bootstrap-admin.ts --outdir dist --target node",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.platform.config.ts"
  },
  "dependencies": {
    "@zhiyun/cloud-contracts": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.13.7",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.8.1",
    "postgres": "^3.4.8",
    "zod": "^4.1.13",
    "nodemailer": "^10.0.6",
    "otpauth": "^9.5.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.9",
    "@types/nodemailer": "^7.0.11"
  }
}
