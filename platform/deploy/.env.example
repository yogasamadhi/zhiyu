# Copy to platform/deploy/.env for an isolated test stack. Never put production credentials here.
NODE_ENV=test
CLOUD_PORT=3200
CLOUD_POSTGRES_PASSWORD=change-me-test-only
CLOUD_DATABASE_URL=postgres://zhiyun:change-me-test-only@postgres:5432/zhiyun_cloud
CLOUD_REDIS_URL=redis://redis:6379
CLOUD_PORTAL_ORIGIN=https://portal.localhost:8443
CLOUD_ADMIN_ORIGIN=https://admin.localhost:8443
CLOUD_MOCK_PAYMENTS=true
CLOUD_REAL_MESSAGES=false
CLOUD_MFA_KEY=replace-with-at-least-32-random-characters
CLOUD_MODEL_ORIGINS=
CLOUD_DAILY_TOKEN_BUDGET=1000000
PORTAL_HOST=portal.localhost
ADMIN_HOST=admin.localhost
API_HOST=api.localhost
# Real test upstream opt-in: Admin keyRef refers to this environment variable name.
# CLOUD_MODEL_ORIGINS=https://test-model.example.com
# ZHIYUN_TEST_MODEL_KEY=independent-test-key
# Real sending is separately opt-in and has not been externally verified.
# CLOUD_SMTP_URL=smtps://user:password@smtp.example.com:465
# CLOUD_MAIL_FROM=noreply@example.com
# CLOUD_ALIYUN_ACCESS_KEY_ID=
# CLOUD_ALIYUN_ACCESS_KEY_SECRET=
# CLOUD_ALIYUN_SMS_SIGN=
# CLOUD_ALIYUN_SMS_TEMPLATE=
