            "title": "Resourcelimits",
            "type": "object"
          },
          "supportedFieldTypes": {
            "items": {
              "type": "string"
            },
            "title": "Supportedfieldtypes",
            "type": "array"
          },
          "supportsSampling": {
            "default": false,
            "title": "Supportssampling",
            "type": "boolean"
          },
          "titleKey": {
            "title": "Titlekey",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "category",
          "titleKey",
          "descriptionKey",
          "parameterSchema",
          "outputSchema"
        ],
        "title": "MethodDescriptor",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "code",
          "detail"
        ],
        "title": "Problem",
        "type": "object"
      },
      "WorkerCapabilities": {
        "additionalProperties": false,
        "properties": {
          "arbitraryCodeExecution": {
            "const": false,
            "default": false,
            "title": "Arbitrarycodeexecution",
            "type": "boolean"
          },
          "arbitrarySqlExecution": {
            "const": false,
            "default": false,
