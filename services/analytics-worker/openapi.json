            "title": "Phase",
            "type": "string"
          },
          "progress": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress",
            "type": "number"
          },
          "startedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Startedat"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "canceling",
              "canceled",
              "succeeded",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "methodId",
          "methodVersion",
          "state",
          "phase",
          "progress",
          "createdAt"
        ],
        "title": "WorkerJob",
        "type": "object"
      },
      "WorkerJobError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "WorkerJobError",
        "type": "object"
      },
      "WorkerJobSubmission": {
        "additionalProperties": false,
        "properties": {
          "inputArtifactRef": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inputartifactref"
          },
          "jobId": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Jobid",
            "type": "string"
          },
          "methodId": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Methodid",
            "type": "string"
          },
          "methodVersion": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Methodversion",
            "type": "string"
          },
          "outputArtifactRef": {
            "default": "result.json",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Outputartifactref",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          }
        },
        "required": [
          "jobId",
          "methodId",
          "methodVersion"
        ],
        "title": "WorkerJobSubmission",
        "type": "object"
      },
      "WorkerVersion": {
        "additionalProperties": false,
        "properties": {
          "generation": {
            "title": "Generation",
            "type": "integer"
          },
          "protocolVersion": {
            "const": "worker/v1",
            "default": "worker/v1",
            "title": "Protocolversion",
            "type": "string"
          },
          "workerVersion": {
            "title": "Workerversion",
            "type": "string"
          }
        },
        "required": [
          "workerVersion",
          "generation"
        ],
        "title": "WorkerVersion",
        "type": "object"
      }
    }
  },
