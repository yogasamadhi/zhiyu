            "type": "boolean"
          }
        },
        "title": "WorkerCapabilities",
        "type": "object"
      },
      "WorkerJob": {
        "additionalProperties": false,
        "properties": {
          "completedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completedat"
          },
          "createdAt": {
            "format": "date-time",
