{
  "name": "@zhiyun/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "development": "./src/index.ts",
    "bun": "./src/index.ts",
    "types": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --packages external",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@zhiyun/contracts": "workspace:*",
    "@zhiyun/shared": "workspace:*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.8"
  }
}
