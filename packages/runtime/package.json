{
  "name": "@zhiyun/runtime",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "development": "./src/index.ts",
    "bun": "./src/index.ts",
    "types": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/utility-entry.ts --outfile dist/utility-entry.js --target node --format esm --packages bundle --external better-sqlite3 --external playwright && bun build src/index.ts --outfile dist/index.js --target node --format esm --packages external",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@zhiyun/ai-runtime": "workspace:*",
    "@zhiyun/browser-runtime": "workspace:*",
    "@zhiyun/contracts": "workspace:*",
    "@zhiyun/crawler-runtime": "workspace:*",
    "@zhiyun/exporters": "workspace:*",
    "@zhiyun/extraction": "workspace:*",
    "@zhiyun/kernel": "workspace:*",
    "@zhiyun/platform": "workspace:*",
    "@zhiyun/plugin-ai-assistance": "workspace:*",
    "@zhiyun/preferences": "workspace:*",
    "@zhiyun/product-profiles": "workspace:*",
    "@zhiyun/outputs": "workspace:*",
    "@zhiyun/rules": "workspace:*",
    "@zhiyun/scheduler": "workspace:*",
    "@zhiyun/sqlite-storage": "workspace:*",
    "cheerio": "^1.1.2",
    "fastify": "^5.12.1",
    "playwright": "1.62.1",
    "zod": "^4.1.13"
  }
}
