{
  "name": "dsh-zhiyun",
  "version": "0.1.0",
  "description": "Local web collection, datasets, analytics and corpus workbench for DeepSeek Harness",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.1-rc.3"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/shared/protocol.d.ts",
      "default": "./lib/types.js"
    }
  },
  "files": [
    "lib",
    "resources",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.json",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "resources": "tsx scripts/resources.ts",
    "package": "tsx scripts/package.ts",
    "test": "tsx scripts/test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.runtime.json && tsc --noEmit -p tsconfig.workbench.json",
    "lint": "eslint --config eslint.config.js src scripts test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "4.4.3",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "esbuild": "^0.28.2",
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "postcss": "^8.5.6",
    "postcss-prefix-selector": "^2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.21.3",
    "@zhiyun/runtime": "workspace:*",
    "@zhiyun/ui-sdk": "workspace:*",
    "@zhiyun/client": "workspace:*",
    "@zhiyun/product-profiles": "workspace:*",
    "@zhiyun/analytics-worker-client": "workspace:*",
    "@zhiyun/contracts": "workspace:*",
    "@zhiyun/ai-runtime": "workspace:*",
    "@zhiyun/crawler-runtime": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "react-router-dom": "^7.12.0",
    "react-i18next": "^16.5.4",
    "@zhiyun/shared": "workspace:*",
    "playwright": "1.62.1"
  }
}
