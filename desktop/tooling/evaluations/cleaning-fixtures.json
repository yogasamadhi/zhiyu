      ],
      "steps": [
        {
          "type": "merge",
          "fields": ["name", "count", "flag"],
          "target": "label",
          "separator": " / "
        }
      ],
      "expected": [
        { "name": "Alpha", "count": 2, "flag": true, "label": "Alpha / 2 / true" },
        { "name": null, "count": 0, "flag": false, "label": "0 / false" },
