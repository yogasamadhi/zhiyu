{
  "name": "@zhiyun/browser-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "development": "./src/index.ts",
    "types": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "node ../../../tooling/scripts/build-package.ts src/index.ts --outdir dist --target node --format esm --packages external",
