    "demo:stagehand": "tsx src/stagehand-demo.ts"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.0.2",
    "@zhiyun/shared": "workspace:*",
    "playwright": "1.62.1"
  }
}
