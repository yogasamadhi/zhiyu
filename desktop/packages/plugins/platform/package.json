{
  "name": "@zhiyun/plugin-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./analytics-worker-adapter": {
      "types": "./src/analytics-worker-adapter.ts",
      "development": "./src/analytics-worker-adapter.ts",
      "default": "./dist/analytics-worker-adapter.js"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "development": "./src/manifest.ts",
      "default": "./dist/manifest.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "development": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "browser": "./src/client/index.tsx",
      "development": "./src/client/index.tsx",
      "default": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "node ../../../../tooling/scripts/build-package.ts ./src/analytics-worker-adapter.ts ./src/client/index.tsx ./src/index.ts ./src/manifest.ts ./src/types.ts --root src --outdir dist --target node --format esm --packages external",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zhiyun/plugin-runtime": "workspace:*",
    "@zhiyun/platform-core": "workspace:*",
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*",
    "@zhiyun/runtime-contracts": "workspace:*",
    "@zhiyun/analytics-worker-client": "workspace:*",
    "@zhiyun/artifact-store": "workspace:*",
    "@zhiyun/ai-runtime": "workspace:*",
    "@zhiyun/contracts": "workspace:*",
    "@zhiyun/crawler-runtime": "workspace:*",
    "@zhiyun/platform": "workspace:*",
    "@zhiyun/preferences": "workspace:*",
    "@zhiyun/product-profiles": "workspace:*",
    "@zhiyun/runtime-gateway": "workspace:*",
    "@zhiyun/queue-local-v1": "workspace:*",
    "@zhiyun/storage-sqlite-v1": "workspace:*",
    "fastify": "^5.12.2",
    "playwright": "1.62.1",
    "zod": "^4.1.13",
    "@zhiyun/plugin-analytics": "workspace:*",
    "@zhiyun/plugin-corpus": "workspace:*",
    "@zhiyun/plugin-datasets": "workspace:*",
    "@zhiyun/ui-sdk": "workspace:*",
    "@zhiyun/client": "workspace:*",
    "react": "18.3.1",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.12.0",
    "@tanstack/react-query": "^5.102.8",
    "lucide-react": "^1.43.0",
    "@zhiyun/shared": "workspace:*",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "i18next": "^25.7.4",
    "react-dom": "18.3.1",
    "@deepseek-ai/cordis-plugin-loader": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7"
  }
}
