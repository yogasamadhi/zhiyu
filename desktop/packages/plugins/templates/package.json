{
  "name": "@zhiyun/plugin-templates",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "development": "./src/manifest.ts",
      "bun": "./src/manifest.ts",
      "default": "./dist/manifest.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "development": "./src/types.ts",
      "bun": "./src/types.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/manifest.ts ./src/types.ts --root src --outdir dist --target node --format esm --packages external",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zhiyun/plugin-runtime": "workspace:*",
    "@zhiyun/platform-core": "workspace:*",
    "@zhiyun/plugin-collection": "workspace:*",
    "@zhiyun/shared": "workspace:*",
    "fastify": "^5.12.2",
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*",
    "@zhiyun/runtime-contracts": "workspace:*",
    "@zhiyun/analytics-worker-client": "workspace:*",
    "@zhiyun/artifact-store": "workspace:*",
    "@zhiyun/ai-runtime": "workspace:*",
    "@zhiyun/contracts": "workspace:*",
    "@zhiyun/crawler-runtime": "workspace:*",
    "@zhiyun/platform": "workspace:*",
    "@zhiyun/preferences": "workspace:*",
    "@zhiyun/product-profiles": "workspace:*",
    "@zhiyun/runtime-gateway": "workspace:*",
    "@zhiyun/queue-local-v1": "workspace:*",
    "@zhiyun/storage-sqlite-v1": "workspace:*",
    "playwright": "1.62.1",
    "zod": "^4.1.13",
    "@tanstack/react-query": "^5.102.8",
    "@zhiyun/client": "workspace:*",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "i18next": "^25.7.4",
    "lucide-react": "^1.43.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.12.0",
    "@deepseek-ai/cordis-plugin-loader": "workspace:*"
  },
  "devDependencies": {
    "@zhiyun/storage-sqlite-v1": "workspace:*"
  }
}
