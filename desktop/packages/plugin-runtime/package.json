{
  "name": "@zhiyun/plugin-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "browser": "./src/client.ts",
      "development": "./src/client.ts",
      "bun": "./src/client.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/client.ts ./src/index.ts --root src --outdir dist --target node --format esm --packages external",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:*",
    "@deepseek-ai/cordis-plugin-include": "workspace:*",
    "@deepseek-ai/cordis-plugin-group": "workspace:*",
    "@deepseek-ai/cordis-plugin-timer": "workspace:*",
    "@deepseek-ai/cordis-plugin-logger-console": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  }
}
