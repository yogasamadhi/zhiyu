{
  "name": "zhiyun",
  "version": "1.0.0",
  "private": true,
  "description": "Practical Intelligent Web Data Extraction Platform",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "desktop",
    "desktop/packages/*",
    "desktop/packages/plugins/*",
    "desktop/packages/capabilities/*",
    "desktop/packages/profiles/*",
    "desktop/tooling/fixtures",
    "platform/admin",
    "platform/portal",
    "platform/packages/*",
    "platform/server"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run-desktop.ts",
    "dev:fixtures": "bun run --filter @zhiyun/fixtures dev",
    "desktop:dev": "bun run-desktop.ts",
    "desktop:build": "bun run --filter @zhiyun/desktop build",
    "desktop:package": "bun run --filter @zhiyun/desktop package",
    "desktop:make": "bun run --filter @zhiyun/desktop make",
    "desktop:test": "bun --no-env-file desktop/tooling/scripts/test-e2e-isolated.ts development",
    "desktop:browser": "bun run --filter @zhiyun/desktop browser:prepare",
    "build": "tsc --noEmit && bun run --workspaces --if-present build",
    "test": "bun --no-env-file desktop/tooling/scripts/test-isolated.ts",
    "test:unit": "vitest run desktop/packages",
    "test:platform": "vitest run desktop/packages/platform-core desktop/packages/capabilities/storage-sqlite desktop/packages/capabilities/queue-local desktop/packages/capabilities/artifact-store",
    "test:worker-client": "vitest run desktop/packages/capabilities/analytics-worker-client/test",
    "test:integration": "bun desktop/tooling/scripts/test-isolated.ts desktop/packages/runtime/test",
    "ai:evaluate": "bun --no-env-file desktop/tooling/scripts/evaluate-rule-repair.ts",
    "test:conformance": "vitest run -t conformance",
    "test:security": "vitest run -t security",
    "test:performance": "ZHIYUN_PERFORMANCE=1 vitest run -t performance --testTimeout=240000",
    "test:watch": "vitest",
    "test:e2e": "bun run desktop:test",
    "test:e2e:desktop": "bun run desktop:test",
    "test:smoke:desktop-package": "bun --no-env-file desktop/tooling/scripts/test-e2e-isolated.ts packaged",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && bun run --workspaces --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "browser:install": "playwright install chromium",
    "client:generate": "bun run --filter @zhiyun/client generate",
    "client:check": "bun run --filter @zhiyun/client check:generated",
    "worker:sync": "cd desktop/analytics-worker && uv sync --frozen",
    "worker:test": "cd desktop/analytics-worker && uv run pytest",
    "worker:lint": "cd desktop/analytics-worker && uv run ruff check src tests scripts packaging",
    "worker:format": "cd desktop/analytics-worker && uv run ruff format src tests scripts packaging",
    "worker:openapi:generate": "cd desktop/analytics-worker && uv run python scripts/export_openapi.py",
    "worker:openapi:check": "cd desktop/analytics-worker && uv run python scripts/export_openapi.py --check",
    "worker:client:generate": "bun run --filter @zhiyun/analytics-worker-client generate",
    "worker:client:check": "bun run worker:openapi:check && bun run --filter @zhiyun/analytics-worker-client check:generated",
    "worker:build": "cd desktop/analytics-worker && uv run python scripts/build.py",
    "worker:smoke": "cd desktop/analytics-worker && uv run python scripts/smoke.py",
    "architecture:generate": "bun run --filter @zhiyun/product-profiles architecture:generate",
    "architecture:check": "bun run --filter @zhiyun/product-profiles architecture:check",
    "architecture:deps": "depcruise --config dependency-cruiser.config.cjs desktop platform --output-type err",
    "dependency:audit": "bun audit --registry=https://registry.npmjs.org --audit-level=high --ignore=GHSA-w3rx-r6r6-pgpr && bun --no-env-file tooling/scripts/audit-dependency-patches.ts",
    "compliance:licenses": "bun tooling/scripts/generate-node-licenses.ts && cd desktop/analytics-worker && uv run python scripts/export_licenses.py ../../.artifacts/compliance/python.json",
    "release:verify": "bun run lint && bun run worker:lint && bun run format:check && bun run architecture:deps && bun run architecture:check && bun run client:check && bun run worker:client:check && bun run typecheck && bun run worker:test && bun run test && bun run build && bun run dependency:audit && bun run compliance:licenses && bun run cloud:check",
    "platform:dev": "bun run-platform.ts",
    "cloud:dev": "bun run-platform.ts",
    "cloud:infra": "docker compose -f platform/deploy/compose.yml up -d postgres redis",
    "cloud:migrate": "bun platform/server/src/migrate.ts",
    "cloud:test": "bun --no-env-file platform/tooling/scripts/test-isolated.ts unit",
    "cloud:test:isolation": "bun --no-env-file test platform/tooling/tests",
    "cloud:contract": "bun platform/tooling/scripts/contract.ts",
    "cloud:contract:check": "bun platform/tooling/scripts/contract.ts --check",
    "cloud:check": "bun run cloud:contract:check && bun run --filter \"@zhiyun/cloud-*\" typecheck && bun run --filter @zhiyun/portal typecheck && bun run --filter @zhiyun/admin typecheck",
    "cloud:build": "bun run --filter @zhiyun/cloud-server build && bun run --filter @zhiyun/portal build && bun run --filter @zhiyun/admin build",
    "cloud:e2e": "bun --no-env-file platform/tooling/scripts/test-isolated.ts e2e",
    "test:e2e:cloud": "bun run cloud:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.10.13",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "^3.8.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.0",
    "openapi-typescript": "^7.13.0"
  },
  "overrides": {
    "@electron/rebuild": "4.2.0",
    "@sapphire/shapeshift": "3.9.7",
    "tmp": "0.2.7",
    "js-yaml": "4.3.2",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.5",
    "adm-zip": "0.6.1",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12",
    "fast-uri@^3": "3.1.8",
    "fast-uri@^4": "4.1.5",
    "undici@^6": "6.28.1",
    "undici@^7": "7.29.1",
    "braces": "file:./tooling/dependency-patches/braces",
    "http-cache-semantics": "file:./tooling/dependency-patches/http-cache-semantics"
  },
  "patchedDependencies": {
    "proxy-chain@2.7.1": "tooling/dependency-patches/proxy-chain@2.7.1.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "better-sqlite3",
    "electron",
    "msgpackr-extract",
    "playwright",
    "sharp"
  ]
}
